# 复制为 .env 后修改。docker compose 会自动读取同目录的 .env。

# 中转的公网域名（Caddy 自动签证书，须已解析到本机且 80/443 可达）
TX_DOMAIN=tx.example.com

# 控制台登录密码（第一阶段单用户；请用长随机串，例如 openssl rand -base64 24）
TX_ADMIN_PASSWORD=change-me

# 证书通知邮箱（可选）
TX_ACME_EMAIL=

# 镜像标签（可选，默认 dev）
TX_VERSION=dev

# 日志级别：debug | info | warn | error
TX_LOG_LEVEL=info

# 额外允许的 WebSocket 来源，逗号分隔（只在本地开发 Vite 时需要，生产留空）
TX_ALLOW_ORIGIN=
